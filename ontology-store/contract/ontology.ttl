@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <http://example.org/ontology/meta#> .
@prefix store: <http://example.org/ontology/contract#> .

# Generated by the DeepSeek Harness ontology workbench.

store:Contract a owl:Class ;
  rdfs:label "合同" ;
  rdfs:comment "双方或多方之间设立、变更、终止民事权利义务关系的协议" .


store:Party a owl:Class ;
  rdfs:label "签约方" ;
  rdfs:comment "合同的一方当事人，可以是自然人或法人" .


store:Term a owl:Class ;
  rdfs:label "条款" ;
  rdfs:comment "合同中具有独立法律意义的一条约定" .


store:Obligation a owl:Class ;
  rdfs:label "义务" ;
  rdfs:comment "合同一方应当履行的行为或不行为" .


store:Signature a owl:Class ;
  rdfs:label "签署" ;
  rdfs:comment "签约方在合同上签字或盖章的行为" .


store:hasParty a owl:ObjectProperty ;
  rdfs:label "有签约方" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Party .


store:participatesIn a owl:ObjectProperty ;
  rdfs:label "参与合同" ;
  rdfs:comment "签约方参与某份合同，是 hasParty 的反向遍历关系" ;
  rdfs:domain store:Party ;
  rdfs:range store:Contract .


store:hasTerm a owl:ObjectProperty ;
  rdfs:label "包含条款" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Term .


store:imposes a owl:ObjectProperty ;
  rdfs:label "设定义务" ;
  rdfs:domain store:Term ;
  rdfs:range store:Obligation .


store:signedBy a owl:ObjectProperty ;
  rdfs:label "由方签署" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Signature .


store:contractId a owl:DatatypeProperty ;
  rdfs:label "合同编号" ;
  rdfs:comment "合同的业务唯一标识" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:contractTitle a owl:DatatypeProperty ;
  rdfs:label "合同标题" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:contractType a owl:DatatypeProperty ;
  rdfs:label "合同类型" ;
  rdfs:comment "业务分类，如采购合同、服务合同" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:contractStatus a owl:DatatypeProperty ;
  rdfs:label "合同状态" ;
  rdfs:comment "履约阶段，如起草、审批中、履行中、已终止" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:currency a owl:DatatypeProperty ;
  rdfs:label "币种" ;
  rdfs:comment "合同金额的币种，ISO 4217 代码，如 CNY" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:contractAmount a owl:DatatypeProperty ;
  rdfs:label "合同金额" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:decimal .


store:department a owl:DatatypeProperty ;
  rdfs:label "归口部门" ;
  rdfs:comment "负责履行与管理该合同的内部部门" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:region a owl:DatatypeProperty ;
  rdfs:label "所属区域" ;
  rdfs:comment "合同标的或履约地的行政区域" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:effectiveDate a owl:DatatypeProperty ;
  rdfs:label "生效日期" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:date .


store:expiryDate a owl:DatatypeProperty ;
  rdfs:label "失效日期" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:date .


store:signedDate a owl:DatatypeProperty ;
  rdfs:label "签署日期" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:date .


store:partyId a owl:DatatypeProperty ;
  rdfs:label "当事人编号" ;
  rdfs:comment "签约方的业务唯一标识" ;
  rdfs:domain store:Party ;
  rdfs:range xsd:string .


store:partyName a owl:DatatypeProperty ;
  rdfs:label "当事人名称" ;
  rdfs:comment "自然人姓名或法人全称" ;
  rdfs:domain store:Party ;
  rdfs:range xsd:string .


store:partyType a owl:DatatypeProperty ;
  rdfs:label "当事人类型" ;
  rdfs:comment "如自然人、法人、其他组织" ;
  rdfs:domain store:Party ;
  rdfs:range xsd:string .


store:creditCode a owl:DatatypeProperty ;
  rdfs:label "统一社会信用代码" ;
  rdfs:comment "法人或其他组织的登记标识" ;
  rdfs:domain store:Party ;
  rdfs:range xsd:string .


store:partyRole a owl:DatatypeProperty ;
  rdfs:label "当事人角色" ;
  rdfs:comment "在该合同中的角色，如甲方、乙方、担保方" ;
  rdfs:domain store:Party ;
  rdfs:range xsd:string .
