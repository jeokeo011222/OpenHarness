@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix contract: <http://example.org/ontology/contract#> .

contract:Contract a owl:Class ;
    rdfs:label "合同" ;
    rdfs:comment "双方或多方之间设立、变更、终止民事权利义务关系的协议" .

contract:Party a owl:Class ;
    rdfs:label "签约方" ;
    rdfs:comment "合同的一方当事人，可以是自然人或法人" .

contract:Term a owl:Class ;
    rdfs:label "条款" ;
    rdfs:comment "合同中具有独立法律意义的一条约定" .

contract:Obligation a owl:Class ;
    rdfs:label "义务" ;
    rdfs:comment "合同一方应当履行的行为或不行为" .

contract:Signature a owl:Class ;
    rdfs:label "签署" ;
    rdfs:comment "签约方在合同上签字或盖章的行为" .

contract:hasParty a owl:ObjectProperty ;
    rdfs:label "签约方" ;
    rdfs:domain contract:Contract ;
    rdfs:range contract:Party .

contract:hasTerm a owl:ObjectProperty ;
    rdfs:label "包含条款" ;
    rdfs:domain contract:Contract ;
    rdfs:range contract:Term .

contract:imposes a owl:ObjectProperty ;
    rdfs:label "设定义务" ;
    rdfs:domain contract:Term ;
    rdfs:range contract:Obligation .

contract:signedBy a owl:ObjectProperty ;
    rdfs:label "由方签署" ;
    rdfs:domain contract:Contract ;
    rdfs:range contract:Signature .

contract:contractTitle a owl:DatatypeProperty ;
    rdfs:label "合同标题" ;
    rdfs:domain contract:Contract ;
    rdfs:range xsd:string .

contract:signedDate a owl:DatatypeProperty ;
    rdfs:label "签署日期" ;
    rdfs:domain contract:Contract ;
    rdfs:range xsd:date .

contract:contractAmount a owl:DatatypeProperty ;
    rdfs:label "合同金额" ;
    rdfs:domain contract:Contract ;
    rdfs:range xsd:decimal .
