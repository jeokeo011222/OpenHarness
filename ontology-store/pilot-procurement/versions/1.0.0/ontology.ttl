@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <http://example.org/ontology/meta#> .
@prefix store: <http://example.org/ontology/pilot-procurement#> .

# Generated by the DeepSeek Harness ontology workbench.

store:Contract a owl:Class ;
  rdfs:label "合同" ;
  rdfs:comment "采购方与供应方签订的采购合同" ;
  meta:sourceClause "第一条" .


store:Party a owl:Class ;
  rdfs:label "合同主体" ;
  rdfs:comment "参与合同签订的当事方" ;
  meta:sourceClause "第一条" .


store:Purchaser a owl:Class ;
  rdfs:label "采购方" ;
  rdfs:comment "合同中的甲方，负责支付预付款" ;
  meta:sourceClause "第一条" .


store:Supplier a owl:Class ;
  rdfs:label "供应方" ;
  rdfs:comment "合同中的乙方，提供货物或服务" ;
  meta:sourceClause "第一条" .


store:hasparty a owl:ObjectProperty ;
  rdfs:label "签约方" ;
  rdfs:comment "合同由合同主体签订" ;
  meta:sourceClause "第一条" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Party .


store:haspurchaser a owl:ObjectProperty ;
  rdfs:label "采购方" ;
  rdfs:comment "合同对应的甲方" ;
  meta:sourceClause "第一条" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Purchaser .


store:hassupplier a owl:ObjectProperty ;
  rdfs:label "供应方" ;
  rdfs:comment "合同对应的乙方" ;
  meta:sourceClause "第一条" ;
  rdfs:domain store:Contract ;
  rdfs:range store:Supplier .


store:paymenttermdays a owl:DatatypeProperty ;
  rdfs:label "付款期限" ;
  rdfs:comment "合同生效后支付预付款的天数" ;
  meta:sourceClause "第一条" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:deliverydeadlinedays a owl:DatatypeProperty ;
  rdfs:label "交付期限" ;
  rdfs:comment "合同签订之日起完成交付的天数" ;
  meta:sourceClause "第二条" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:decimal .


store:acceptancedeadlinedays a owl:DatatypeProperty ;
  rdfs:label "验收期限" ;
  rdfs:comment "收到货物后完成验收的天数" ;
  meta:sourceClause "第二条" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:decimal .


store:requiresacceptancereport a owl:DatatypeProperty ;
  rdfs:label "验收报告" ;
  rdfs:comment "验收后是否需出具验收报告" ;
  meta:sourceClause "第二条" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:string .


store:qualityguaranteeperiodmonths a owl:DatatypeProperty ;
  rdfs:label "质量保证期（月）" ;
  rdfs:comment "乙方对所供货物提供的质量保证期，以月计" ;
  meta:sourceClause "第三条" ;
  rdfs:domain store:Contract ;
  rdfs:range xsd:decimal .
