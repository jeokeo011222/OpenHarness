# ---------------------------------------------------------------------------
# OntoRAG 环境变量模板：复制为 .env 后填写。
# 任何密钥都不得写进代码或镜像；compose 通过 env_file 注入。
# ---------------------------------------------------------------------------

# dev | staging | prod
ENVIRONMENT=dev
# memory：本地演示（进程内，不需要 Fuseki / PostgreSQL / 模型）
# live：真实依赖（Fuseki + PostgreSQL + 模型）
RAG_MODE=live

# 检索后端：pg（PostgreSQL + pgvector，测试阶段默认）| es（ES + Milvus，既有部署）
RETRIEVAL_BACKEND=pg
# 审计后端：auto（跟随检索后端）| sqlite | pg
AUDIT_BACKEND=auto
# 租户密钥来源：auto（连了 pg 就从库读，首次用 TENANT_KEYS 引导入库）| env | db
TENANT_STORE=auto

# 租户密钥表（引导用）：JSON 对象，键为租户 id，值为该租户的 API Key
TENANT_KEYS={"demo": "change-me-demo-key"}
REQUIRE_AUTH=true
# 调试面板：/debug 页面 + /v1/debug/* 接口。会返回分块原文、命中理由与冲突明细，
# 鉴权仍按租户走，但暴露面大于 /v1/query —— 正式环境置 false。
DEBUG_PANEL_ENABLED=true

# ---------------- Apache Jena Fuseki（图数据，不迁入 pgsql） ----------------
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=ontorag
# SHACL 引擎会用 GSP 往临时图里写待校验数据，需要管理员账号，否则 401
FUSEKI_USER=admin
FUSEKI_PASSWORD=change-me-fuseki
SPARQL_TIMEOUT_SECONDS=15
# 面向模型的 SPARQL 工具可申请的最大耗时；调用方只能调小
SPARQL_MAX_TIMEOUT_SECONDS=30
SPARQL_MAX_ROWS=500
# 工具允许的查询形态（逗号分隔）。收紧到 select 是产品决定：
# CONSTRUCT/DESCRIBE 会把大段子图塞进上下文，容易被拿来"看图说话"
SPARQL_ALLOWED_FORMS=select

# ---------------- SHACL 校验引擎 ----------------
# auto：live 且有图存储时用 fuseki（形状编译成 SPARQL 交给图库），否则 pyshacl
# 显式指定 fuseki / local 可用于双引擎比对与排障
SHACL_BACKEND=auto
SHACL_MAX_ROWS=1000

# ---------------- 实体链接 ----------------
# true：DeepSeek Flash 先抽候选术语，再由本体词表映射 IRI（模型不碰 IRI）
ENTITY_LINK_USE_LLM=true
ENTITY_LINK_VOCAB_LIMIT=240

# ---------------- PostgreSQL + pgvector（关系库 + 向量库 + 审计 + 租户） ----------------
# compose 会按下面的账号密码拼出容器内 DSN；直连宿主调试时改这一行即可
PG_DSN=postgresql://ontorag:change-me-pg@postgres:5432/ontorag
PG_USER=ontorag
PG_PASSWORD=change-me-pg
PG_DATABASE=ontorag
PG_PORT=5432
PG_POOL_MIN=1
PG_POOL_MAX=8
PG_CONNECT_TIMEOUT=10
# 启动时自动建表（幂等）；生产可关掉，改由 init_pg.py 走变更流程
PG_AUTO_MIGRATE=true
# 向量维度必须与 embedding 模型一致；换模型要重建 chunk_vector
EMBEDDING_DIM=1024

# ---------------- Elasticsearch + Milvus（仅 RETRIEVAL_BACKEND=es 时使用） ----------------
ES_URL=http://elasticsearch:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PREFIX=ontorag
ES_TIMEOUT_SECONDS=10
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=ontorag_chunks
MILVUS_DIM=1024

# ---------------- DeepSeek ----------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 留空则用确定性哈希向量（离线可用，但向量层不代表真实 embedding 质量）
DEEPSEEK_API_KEY=
LLM_MODEL_FLASH=deepseek-4.1-flash
LLM_MODEL_STRONG=deepseek-reasoner
EMBEDDING_MODEL=deepseek-embedding
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------------- 成本与熔断 ----------------
DAILY_TOKEN_BUDGET=2000000
TASK_TOKEN_LIMIT=24000
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30

# ---------------- 检索权重（必须归一） ----------------
WEIGHT_GRAPH=0.60
WEIGHT_KEYWORD=0.25
WEIGHT_VECTOR=0.15

# ---------------- 三级检索：窗口、触发门槛与打分 ----------------
# 候选窗口倍数：召回层要留过滤余量，否则兼容性过滤一删就凑不满 top_k
RETRIEVAL_KEYWORD_WINDOW=3
RETRIEVAL_VECTOR_WINDOW=3
# 前两级"条数 >= top_k 且 最高分 >= 该值"时不再跑向量。
# 0.45 ≈ 一次图谱命中的典型得分，即"有实打实的事实支撑"
RETRIEVAL_SUFFICIENCY_SCORE=0.45
# 关键词饱和点 k（x/(x+k) 的 k）；BM25 典型命中 3~12，k=6 时命中 6 次得 0.5
RETRIEVAL_KEYWORD_HALF_SATURATION=6
# 向量噪声基线：余弦低于此值直接丢弃
RETRIEVAL_VECTOR_FLOOR=0.30
# 向量信任折扣（<1）：保证同分时向量排在图谱与关键词之后
RETRIEVAL_VECTOR_TRUST=0.85
# 本体重合度加成（每个类 +10%，属性按 0.5 计）与多通道交叉验证加分
RETRIEVAL_ONTOLOGY_BONUS=0.10
RETRIEVAL_CROSS_VALIDATION_BONUS=0.05
# 临期降权：N 天内到期的现行文件降多少（提示而非排除）
RETRIEVAL_FRESHNESS_WINDOW_DAYS=30
RETRIEVAL_FRESHNESS_PENALTY=0.10

# ---------------- 业务源库（MySQL → RDF 同步） ----------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ontorag
MYSQL_PASSWORD=change-me-mysql
MYSQL_DATABASE=erp

# MinIO（仅 --profile es 的 Milvus 依赖）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
